#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

for tool in node npm git curl; do
  command -v "$tool" >/dev/null || { echo "Missing dependency: $tool" >&2; exit 1; }
done
node -e 'if (Number(process.versions.node.split(".")[0]) < 22) { console.error("The agent engine requires Node 22 or newer."); process.exit(1); }'
claude_command=${CP_CLAUDE_PATH:-claude}
command -v "$claude_command" >/dev/null || {
  echo 'Claude Code was not found. Install it on the host, or set CP_CLAUDE_PATH to its executable.' >&2
  exit 1
}

if [ ! -f .local/bridge-fixtures.json ]; then
  echo 'Missing game fixtures. Start ./local/start, then run ./local/bridge-fixtures.' >&2
  exit 1
fi
if [ ! -f .local/client-bridge/engine.swf ] || [ ! -f .local/client-bridge/build.json ]; then
  echo 'Missing client overlay. Run python3 local/client-bridge/build.py first.' >&2
  exit 1
fi
if [ ! -f .local/ruffle/ruffle.js ]; then
  echo 'Missing Ruffle runtime. Run ./local/start first.' >&2
  exit 1
fi
node --input-type=module - <<'CHECK_FIXTURES'
import { readFileSync } from 'node:fs';
import { validateFixtures } from './local/web/bridge/model.mjs';
validateFixtures(JSON.parse(readFileSync('.local/bridge-fixtures.json', 'utf8')));
CHECK_FIXTURES
curl --fail --silent --show-error --max-time 5 http://localhost:8080/healthz >/dev/null || {
  echo 'The baseline game is not ready on port 8080. Run ./local/start first.' >&2
  exit 1
}

# The host wrapper imports the existing web server, which resolves its own ws dependency.
if [ ! -f local/web/node_modules/ws/package.json ]; then
  npm ci --ignore-scripts --prefix local/web
fi
engine_dependencies_missing=false
for package in @lydell/node-pty @xterm/addon-fit @xterm/addon-serialize @xterm/headless @xterm/xterm ws; do
  if [ ! -f "local/engine/node_modules/$package/package.json" ]; then
    engine_dependencies_missing=true
  fi
done
if [ "$engine_dependencies_missing" = true ]; then
  npm ci --ignore-scripts --prefix local/engine
fi

# Keep this process in the foreground. Claude starts only from the puffle panel.
exec node local/engine/server.mjs

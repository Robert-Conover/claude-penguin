#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

for tool in node npm git curl python3; do
  command -v "$tool" >/dev/null || { echo "Missing dependency: $tool" >&2; exit 1; }
done
node -e 'if (Number(process.versions.node.split(".")[0]) < 22) { console.error("The agent engine requires Node 22 or newer."); process.exit(1); }'
claude_command=${CP_CLAUDE_PATH:-claude}
command -v "$claude_command" >/dev/null || {
  echo 'Claude Code was not found. Install it on the host, or set CP_CLAUDE_PATH to its executable. ./local/doctor --agents checks everything the puffles need.' >&2
  exit 1
}

# Agent mode provisions one owner per project and verifies (or creates) only the
# marked bridgecheck visitor itself; the Alpha/Beta fixture manifest is not needed.
if [ ! -f .local/env ]; then
  echo 'Missing local game configuration. Run ./local/start first.' >&2
  exit 1
fi
if [ ! -f .local/ruffle/ruffle.js ]; then
  echo 'Missing Ruffle runtime. Run ./local/start first.' >&2
  exit 1
fi

# The in-game menu overlay and Pet Shop module are derived from the archived
# client by local/client-bridge/build.py. Build them when missing or when their
# sources changed, then confirm the result; a failed build stops here.
overlay_current() {
  node --input-type=module - <<'CHECK_OVERLAY'
import { existsSync, readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
const hash = file => createHash('sha256').update(readFileSync(file)).digest('hex');
const current = (record, source, output, flag) => {
  if (!existsSync(record) || !existsSync(output)) return false;
  try {
    const build = JSON.parse(readFileSync(record, 'utf8'));
    return build.extensionSha256 === hash(source) && build.outputSha256 === hash(output) && build[flag] === true;
  } catch { return false; }
};
process.exit(current('.local/client-bridge/build.json', 'local/client-bridge/bridge.as',
                     '.local/client-bridge/engine.swf', 'originalTagsUnchanged') &&
             current('.local/client-bridge/adoption-build.json', 'local/client-bridge/ProjectAdoption.as',
                     '.local/client-bridge/puffle_adoption.swf', 'deterministic') ? 0 : 1);
CHECK_OVERLAY
}
if ! overlay_current; then
  echo 'Building the in-game puffle menu and Pet Shop module (python3 local/client-bridge/build.py).'
  echo 'The first build downloads the pinned JPEXS compiler and needs a JDK.'
  python3 local/client-bridge/build.py || {
    echo 'The overlay build failed. Run ./local/doctor --agents to check the JDK and other requirements.' >&2
    exit 1
  }
  overlay_current || { echo 'The overlay build finished but its output does not match its sources.' >&2; exit 1; }
fi
curl --fail --silent --show-error --max-time 5 http://localhost:8080/healthz >/dev/null || {
  echo 'The baseline game is not ready on port 8080. Run ./local/start first.' >&2
  exit 1
}

# The host wrapper imports the existing web server, which resolves its own ws dependency.
if [ ! -f local/web/node_modules/ws/package.json ]; then
  npm ci --ignore-scripts --prefix local/web
fi
engine_dependencies_missing=false
for package in @lydell/node-pty @xterm/addon-fit @xterm/addon-serialize @xterm/headless @xterm/xterm ws; do
  if [ ! -f "local/engine/node_modules/$package/package.json" ]; then
    engine_dependencies_missing=true
  fi
done
if [ "$engine_dependencies_missing" = true ]; then
  npm ci --ignore-scripts --prefix local/engine
fi

# Defaults to .local/agent-engine. The engine explains explicit migration for v1 state.
# Keep this process in the foreground. Claude starts only from the puffle panel.
exec node local/engine/server.mjs

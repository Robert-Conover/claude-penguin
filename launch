#!/bin/sh
# Runs the native Claude Penguin servers from this checkout. See `./launch --help`.
set -eu
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v node >/dev/null 2>&1 || { echo 'launch needs Node 22 or newer on PATH to start; the servers use the pinned runtimes (local/native/build-runtimes.sh).' >&2; exit 1; }
node -e 'if (Number(process.versions.node.split(".")[0]) < 22) process.exit(1)' || { echo 'launch needs Node 22 or newer.' >&2; exit 1; }
exec node "$dir/local/controller/launch-cli.mjs" "$@"
